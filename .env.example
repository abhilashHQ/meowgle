# The model is Claude Code's CLI (`claude -p`), run on a Claude subscription.
# Create an isolated config dir and a long-lived token for it:
#   cmd /c "set CLAUDE_CONFIG_DIR=C:\claude-agent-cfg&& claude setup-token"
CLAUDE_CONFIG_DIR=C:\claude-agent-cfg
CLAUDE_CODE_OAUTH_TOKEN=
# sonnet | opus | haiku, or a full model id
CLAUDE_MODEL=claude-opus-5-5
# Default effort when the UI doesn't send one: low | medium | high
CLAUDE_EFFORT=low
# Optional: path to the claude binary if it isn't on PATH
CLAUDE_BIN=
# When set, every /api route needs it as a Bearer token. Set it before exposing the server.
AGENT_API_TOKEN=
EXA_API_KEY=
PORT=3000
DB_PATH=data/meowgle.db
