# Any OpenAI-compatible chat completions endpoint. Default: Amazon Bedrock, key from Bedrock console > API keys (sent as Bearer).
LLM_BASE_URL=https://bedrock-runtime.ap-south-1.amazonaws.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai.gpt-oss-120b-1:0
# Sent as reasoning_effort: low | medium | high
LLM_EFFORT=low
EXA_API_KEY=
PORT=3000
DB_PATH=data/minimi.db
